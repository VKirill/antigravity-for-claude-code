# nginx / Angie vhost template — reverse proxy to Node.js/Python/any backend
# Replace: DOMAIN, PORT, APP_NAME
# Usage: cp this to /etc/angie/sites-available/DOMAIN.conf then symlink to sites-enabled/
# Test:  angie -t  (or nginx -t)
# Apply: systemctl reload angie

upstream APP_NAME_backend {
    server 127.0.0.1:PORT;
    keepalive 32;
}

# WebSocket upgrade map (place in http{} block or include once globally)
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN www.DOMAIN;

    # Let's Encrypt / ACME validation
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DOMAIN www.DOMAIN;

    # ---- SSL (choose one approach) ----

    # Option A: Certbot / manual certs
    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;

    # Option B: Angie built-in ACME (comment out A, uncomment B)
    # acme letsencrypt;
    # ssl_certificate     $acme_cert_letsencrypt;
    # ssl_certificate_key $acme_cert_key_letsencrypt;

    # ---- TLS settings ----
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    # ---- Security headers ----
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # ---- Logging ----
    access_log /var/log/angie/DOMAIN.access.log;
    error_log  /var/log/angie/DOMAIN.error.log;

    # ---- Proxy ----
    location / {
        proxy_pass         http://APP_NAME_backend;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;

        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_cache_bypass $http_upgrade;
    }

    # Health check (no auth, no rate-limit, no access log)
    location /healthz {
        proxy_pass http://APP_NAME_backend;
        access_log off;
    }

    # Static files (if serving from filesystem)
    # location /static/ {
    #     alias /var/www/APP_NAME/static/;
    #     expires 1y;
    #     add_header Cache-Control "public, immutable";
    #     access_log off;
    # }

    # Rate limiting (requires limit_req_zone in http{} block)
    # location /api/ {
    #     limit_req zone=api burst=20 nodelay;
    #     limit_req_status 429;
    #     proxy_pass http://APP_NAME_backend;
    # }
}
