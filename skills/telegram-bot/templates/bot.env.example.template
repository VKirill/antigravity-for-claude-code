# bot.env.example.template
# Copy to .env and fill in values. Never commit the filled .env to git.
# All values are validated at startup by Zod — missing/invalid = immediate crash.

# ─── Required ───────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
# Format: 110201543:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=

# Bot username (without @) — used for deep links and Mini App URLs
BOT_USERNAME=

# ─── Webhook (leave empty for long polling mode) ─────────────────────────────

# Public HTTPS URL where Telegram delivers updates
# Must be reachable on port 443, 80, 88, or 8443
WEBHOOK_URL=

# Path component of the webhook URL (default: /webhook)
WEBHOOK_PATH=/webhook

# Secret token to validate incoming webhook requests
# Generate: openssl rand -hex 32
# Telegram sends this as X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=

# ─── Redis (required for multi-instance, production sessions) ─────────────────

# IORedis connection URL
# Format: redis://[:password@]host[:port][/db-number]
REDIS_URL=redis://localhost:6379

# Optional: key prefix to avoid collisions if multiple bots share one Redis
REDIS_KEY_PREFIX=tgbot

# ─── Application ─────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=production

# HTTP server port (webhook server only)
PORT=3000

# Host to bind (use 0.0.0.0 for Docker / 127.0.0.1 for local with reverse proxy)
HOST=0.0.0.0

# ─── Admin access ──────────────────────────────────────────────────────────────

# Comma-separated Telegram user IDs with admin access
# Find your ID: @userinfobot
ADMIN_USER_IDS=123456789,987654321

# ─── Payments (optional) ───────────────────────────────────────────────────────

# Payment provider token from BotFather /mybots → Payments (fiat Payments 2.0 only)
# Leave empty for Stars-only bots (XTR needs no provider token)
PAYMENT_PROVIDER_TOKEN=

# ─── Mini App (optional) ────────────────────────────────────────────────────────

# URL of your Mini App frontend (set as menu button target in BotFather)
MINI_APP_URL=https://app.{{YOUR_DOMAIN}}.com

# ─── Observability (optional) ─────────────────────────────────────────────────

# Sentry DSN for error tracking
SENTRY_DSN=

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Database (optional — depends on your ORM/driver) ───────────────────────────

# DATABASE_URL=postgresql://user:password@localhost:5432/botdb
