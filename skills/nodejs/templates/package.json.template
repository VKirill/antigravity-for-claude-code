{
  "_comment": "templates/package.json.template — copy to project root, replace {{placeholders}}",
  "name": "{{app_name}}",
  "version": "0.1.0",
  "description": "{{app_description}}",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev":        "node --watch src/app/index.ts",
    "start":      "node dist/app/index.js",
    "build":      "tsc --project tsconfig.build.json",
    "typecheck":  "tsc --noEmit",
    "test":       "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "test:cov":   "node --test --experimental-test-coverage 'src/**/*.test.ts'",
    "lint":       "eslint src",
    "lint:fix":   "eslint src --fix",
    "audit:deps": "bash scripts/check-deps.sh"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "pino": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "pino-pretty": "^13.0.0"
  },
  "imports": {
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*"
  }
}
