# templates/.env.example.template
# Purpose: Typed env vars with Zod validation comments.
#          Copy to .env.example, then .env (never commit .env).
# Usage:   Every variable here MUST appear in your EnvSchema (Zod).
#          Validation runs at startup — missing or malformed vars exit the process.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development                  # z.enum(['development', 'test', 'production'])
PORT=3000                             # z.coerce.number().min(1).max(65535)
HOST=0.0.0.0                          # z.string().ip() or z.string()
LOG_LEVEL=info                        # z.enum(['trace','debug','info','warn','error','fatal'])

# ---------------------------------------------------------------------------
# Database — validated with z.string().url()
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://{{db_user}}:{{db_password}}@{{db_host}}:5432/{{db_name}}

# Connection pool — z.coerce.number().min(1).max(50)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis — validated with z.string().url()
# ---------------------------------------------------------------------------
REDIS_URL=redis://:{{redis_password}}@{{redis_host}}:6379/0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# MUST be min 32 chars in production — z.string().min(32)
JWT_SECRET={{generate_with: openssl rand -base64 48}}

# Expiry in vercel/ms format — z.string().regex(/^\d+[smhd]$/)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# CORS allowed origin — z.string().url() or z.literal('*')
CORS_ORIGIN=http://localhost:5173

# Optional: S3-compatible storage
# S3_BUCKET={{bucket_name}}
# S3_REGION={{aws_region}}
# S3_ACCESS_KEY_ID={{access_key}}
# S3_SECRET_ACCESS_KEY={{secret_key}}

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME={{app_name}}
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
