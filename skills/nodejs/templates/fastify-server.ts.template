// templates/fastify-server.ts.template
// Purpose: Production-grade Fastify 5 server with error handling, Pino logging,
//          health route, graceful shutdown, and OpenTelemetry init stub.
// Usage:   Copy to src/app/server.ts, replace {{placeholders}}, run `npm install`.
// Deps:    fastify, @fastify/helmet, @fastify/cors, @fastify/rate-limit, pino

import Fastify, { FastifyInstance, FastifyRequest, FastifyReply } from 'fastify'
import helmet from '@fastify/helmet'
import cors from '@fastify/cors'
import rateLimit from '@fastify/rate-limit'

// ---------------------------------------------------------------------------
// Instrumentation — MUST load before any app code when using OpenTelemetry
// In package.json scripts: "start": "node --import ./dist/instrumentation.js dist/app/index.js"
// ---------------------------------------------------------------------------
// import './instrumentation.js'  // uncomment if OTel is wired

// ---------------------------------------------------------------------------
// Config — validated at startup; never access process.env directly elsewhere
// ---------------------------------------------------------------------------
import { z } from 'zod'

const EnvSchema = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('production'),
  PORT: z.coerce.number().default(3000),
  HOST: z.string().default('0.0.0.0'),
  LOG_LEVEL: z.enum(['trace', 'debug', 'info', 'warn', 'error', 'fatal']).default('info'),
  CORS_ORIGIN: z.string().default('{{cors_origin}}'),  // e.g. 'https://app.example.com'
  // DATABASE_URL: z.string().url(),
  // REDIS_URL: z.string().url(),
})

export type Env = z.infer<typeof EnvSchema>

const parseEnv = (): Env => {
  const result = EnvSchema.safeParse(process.env)
  if (!result.success) {
    console.error('Invalid environment variables:', result.error.flatten().fieldErrors)
    process.exit(1)
  }
  return result.data
}

// ---------------------------------------------------------------------------
// App error hierarchy
// ---------------------------------------------------------------------------
export class AppError extends Error {
  constructor(
    message: string,
    public readonly code: string,
    public readonly statusCode: number = 500,
    options?: ErrorOptions,
  ) {
    super(message, options)
    this.name = 'AppError'
    Error.captureStackTrace(this, this.constructor)
  }
}

export class NotFoundError extends AppError {
  constructor(resource: string, id: string) {
    super(`${resource} ${id} not found`, 'NOT_FOUND', 404)
  }
}

export class ValidationError extends AppError {
  constructor(message: string) {
    super(message, 'VALIDATION_ERROR', 400)
  }
}

// ---------------------------------------------------------------------------
// Build server
// ---------------------------------------------------------------------------
export async function buildServer(env: Env): Promise<FastifyInstance> {
  const app = Fastify({
    logger: {
      level: env.LOG_LEVEL,
      transport: env.NODE_ENV === 'development'
        ? { target: 'pino-pretty', options: { translateTime: 'HH:MM:ss Z' } }
        : undefined,
      redact: {
        paths: ['req.headers.authorization', '*.password', '*.secret', '*.token'],
        censor: '[REDACTED]',
      },
    },
    trustProxy: true,           // required behind Angie/nginx/load balancer
    requestIdLogLabel: 'reqId', // appears in every log line for this request
  })

  // Security headers
  await app.register(helmet, {
    contentSecurityPolicy: env.NODE_ENV === 'production',
  })

  // CORS
  await app.register(cors, {
    origin: env.CORS_ORIGIN === '*' ? true : env.CORS_ORIGIN,
    methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
    credentials: true,
  })

  // Rate limiting
  await app.register(rateLimit, {
    max: 100,
    timeWindow: '1 minute',
    errorResponseBuilder: () => ({
      code: 'RATE_LIMIT_EXCEEDED',
      message: 'Too many requests, please slow down.',
    }),
  })

  // Global error handler
  app.setErrorHandler((error, request, reply) => {
    const log = request.log

    if (error instanceof AppError) {
      log.warn({ code: error.code, cause: error.cause }, error.message)
      return reply.status(error.statusCode).send({
        code: error.code,
        message: error.message,
      })
    }

    // Fastify validation errors
    if (error.validation) {
      return reply.status(400).send({
        code: 'VALIDATION_ERROR',
        message: 'Request validation failed',
        details: error.validation,
      })
    }

    // Unexpected error — log full error, return opaque 500
    log.error({ err: error }, 'Unhandled error')
    return reply.status(500).send({
      code: 'INTERNAL_ERROR',
      message: 'An unexpected error occurred',
    })
  })

  // 404 handler
  app.setNotFoundHandler((request, reply) => {
    return reply.status(404).send({
      code: 'NOT_FOUND',
      message: `Route ${request.method} ${request.url} not found`,
    })
  })

  // Health route — responds before auth/rate-limit for k8s probes
  app.get('/health', { config: { rateLimit: { max: 1000 } } }, async () => ({
    status: 'ok',
    uptime: process.uptime(),
    timestamp: new Date().toISOString(),
  }))

  // Register your domain routes here:
  // await app.register(import('../features/users/users.router.js'))

  return app
}

// ---------------------------------------------------------------------------
// Graceful shutdown
// ---------------------------------------------------------------------------
function setupShutdown(
  app: FastifyInstance,
  closeExternal: () => Promise<void>,
): void {
  let isShuttingDown = false

  const shutdown = async (signal: string): Promise<void> => {
    if (isShuttingDown) return
    isShuttingDown = true
    app.log.info({ signal }, 'Shutdown signal received')

    // Deadman timer — prevents infinite hang
    const deadline = setTimeout(() => {
      app.log.error('Graceful shutdown timed out, forcing exit')
      process.exit(1)
    }, 30_000)
    deadline.unref()

    try {
      await app.close()        // stops accepting new requests + drains in-flight
      await closeExternal()    // close DB pool, Redis, workers
      clearTimeout(deadline)
      app.log.info('Shutdown complete')
      process.exit(0)
    } catch (err) {
      app.log.error({ err }, 'Error during shutdown')
      process.exit(1)
    }
  }

  process.once('SIGTERM', () => shutdown('SIGTERM'))
  process.once('SIGINT',  () => shutdown('SIGINT'))
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------
export async function startServer(): Promise<void> {
  const env = parseEnv()
  const app = await buildServer(env)

  // Wire external resources here:
  // const db = await connectDatabase(env.DATABASE_URL)
  // const redis = new IORedis(env.REDIS_URL)

  setupShutdown(app, async () => {
    // await db.end()
    // await redis.quit()
  })

  await app.listen({ port: env.PORT, host: env.HOST })

  // Signal PM2 (or any process manager) that startup is complete
  if (process.send) process.send('ready')
}
