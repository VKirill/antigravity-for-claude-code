// Fastify 5 + Zod via fastify-type-provider-zod.
// End-to-end TypeScript inference from Zod schemas to request/response.

import Fastify from 'fastify';
import {
  serializerCompiler,
  validatorCompiler,
  type ZodTypeProvider,
} from 'fastify-type-provider-zod';
import { z } from 'zod';

const app = Fastify({ logger: true }).withTypeProvider<ZodTypeProvider>();
app.setValidatorCompiler(validatorCompiler);
app.setSerializerCompiler(serializerCompiler);

// --- Schemas ---
const CreateUserBody = z.object({
  email: z.string().email(),
  name: z.string().min(1).max(120),
  age: z.number().int().min(0).max(130).optional(),
});

const UserResponse = z.object({
  id: z.string().uuid(),
  email: z.string().email(),
  name: z.string(),
  createdAt: z.string().datetime(),
});

const ListUsersQuery = z.object({
  limit: z.coerce.number().int().min(1).max(100).default(20),
  cursor: z.string().optional(),
});

const ListUsersResponse = z.object({
  items: z.array(UserResponse),
  nextCursor: z.string().nullable(),
});

// --- Routes ---
app.post('/users', {
  schema: {
    body: CreateUserBody,
    response: { 201: UserResponse },
  },
}, async (req, reply) => {
  // req.body is fully typed: { email: string; name: string; age?: number }
  const user = {
    id: crypto.randomUUID(),
    email: req.body.email,
    name: req.body.name,
    createdAt: new Date().toISOString(),
  };
  return reply.code(201).send(user);  // typed against UserResponse
});

app.get('/users', {
  schema: {
    querystring: ListUsersQuery,
    response: { 200: ListUsersResponse },
  },
}, async (req) => {
  // req.query.limit is number (coerced); req.query.cursor is string | undefined
  return {
    items: [],
    nextCursor: null,
  };
});

app.setErrorHandler((err, req, reply) => {
  if (err.validation) {
    return reply.code(400).send({ error: 'validation_failed', details: err.validation });
  }
  req.log.error({ err }, 'unhandled');
  return reply.code(500).send({ error: 'internal_error' });
});

await app.listen({ port: Number(process.env.PORT ?? 3000), host: '0.0.0.0' });
