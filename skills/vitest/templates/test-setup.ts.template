// src/test/setup.ts — runs before EACH test file
// Configure in vitest.config.ts: test.setupFiles: ['./src/test/setup.ts']
//
// This file is the right place for:
// - Global mock setup that ALL tests need
// - Environment variable defaults for tests
// - Custom matchers or expect extensions
// - DOM environment cleanup (jsdom)
//
// NOT for DB connections or server startup — use globalSetup for those.

import { afterEach, vi } from 'vitest'

// --- Restore all spies after each test ---
// Prevents spy state leaking between tests (critical in Vitest 4 isolation model).
afterEach(() => {
  vi.restoreAllMocks()
  vi.clearAllMocks()
})

// --- Fake timers cleanup ---
// Uncomment if ANY test in the suite might use vi.useFakeTimers.
