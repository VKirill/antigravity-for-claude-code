// vite.config.ts — production preset for {{project_name}}
// Stack: React + TypeScript + Tailwind 4
// Replace {{placeholders}} before use.

import { defineConfig, loadEnv } from 'vite'
import react from '@vitejs/plugin-react-swc'
import tailwindcss from '@tailwindcss/vite'
import path from 'node:path'
import pkg from './package.json' assert { type: 'json' }

export default defineConfig(({ mode }) => {
  // Load env file based on mode — available as process.env.VITE_* in this scope
  const env = loadEnv(mode, process.cwd(), '')

  return {
    // ── Project root & base ───────────────────────────────────────────────────
    root: process.cwd(),
    base: '/',                  // Change to '/sub-path/' if deployed to a sub-path

    // ── Plugins ───────────────────────────────────────────────────────────────
    plugins: [
      react(),                  // SWC-based Fast Refresh (use @vitejs/plugin-react for Babel)
      tailwindcss(),            // Tailwind 4 Vite-native integration
    ],

    // ── Path aliases ──────────────────────────────────────────────────────────
    resolve: {
      alias: {
        '@': path.resolve(__dirname, 'src'),
        '@components': path.resolve(__dirname, 'src/components'),
        '@hooks': path.resolve(__dirname, 'src/hooks'),
        '@utils': path.resolve(__dirname, 'src/utils'),
        '@types': path.resolve(__dirname, 'src/types'),
      },
    },

    // ── Compile-time constants ────────────────────────────────────────────────
    define: {
      __APP_VERSION__: JSON.stringify(pkg.version),
      __APP_NAME__: JSON.stringify(pkg.name),
      // Add feature flags here:
      // __FEATURE_ANALYTICS__: JSON.stringify(env.VITE_ANALYTICS_ENABLED === 'true'),
    },

    // ── Dev server ────────────────────────────────────────────────────────────
    server: {
      host: 'localhost',
      port: 5173,
      strictPort: false,        // Find next free port if 5173 is taken

      // API proxy — remove if your frontend is served from the same origin
      proxy: {
        '/api': {
          target: 'http://localhost:{{api_port}}',
          changeOrigin: true,
          // rewrite: (path) => path.replace(/^\/api/, ''),
        },
      },

      // Warm up critical path modules to reduce first-request latency
      warmup: {
        clientFiles: [
          './src/main.tsx',
          './src/App.tsx',
          './src/routes/**/*.tsx',
        ],
      },
    },

    // ── Build ─────────────────────────────────────────────────────────────────
    build: {
      outDir: 'dist',
      target: 'es2020',         // Adjust to your browser support requirements
      sourcemap: mode === 'development' ? true : 'hidden',   // hidden = sentry-friendly
      minify: 'esbuild',        // Fast. Use 'terser' for max compression (+build time)
      emptyOutDir: true,

      rollupOptions: {
        output: {
          // Manual chunk splitting — vendor deps separated from app code
          manualChunks: {
            'react-vendor': ['react', 'react-dom'],
            // Add other large deps here:
            // 'router-vendor': ['react-router-dom'],
            // 'ui-vendor': ['@radix-ui/react-dialog', ...],
          },
          chunkFileNames: 'assets/[name]-[hash].js',
          entryFileNames: 'assets/[name]-[hash].js',
          assetFileNames: 'assets/[name]-[hash][extname]',
        },
      },

      // Assets smaller than this are inlined as base64 (default: 4096)
      assetsInlineLimit: 4096,

      // Warn when chunks exceed this size (kB)
      chunkSizeWarningLimit: 500,

      reportCompressedSize: true,
    },

    // ── Dependency pre-bundling ───────────────────────────────────────────────
    optimizeDeps: {
      // Add packages that aren't auto-detected (dynamic imports, unusual patterns)
      include: [
        // 'lodash-es',
      ],
    },

    // ── CSS ───────────────────────────────────────────────────────────────────
    css: {
      // PostCSS is auto-detected from postcss.config.js
      // Tailwind 4: handled by the @tailwindcss/vite plugin above, not here
    },
  }
})
