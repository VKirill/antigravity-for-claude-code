{
  "_comment": "Merge these into your package.json — lint and check scripts compatible with eslint-config-prettier coexistence",
  "scripts": {
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint --fix",
    "lint:ci": "eslint . --cache --cache-location node_modules/.cache/eslint --max-warnings 0",
    "lint:debug": "eslint --inspect-config",
    "lint:print": "eslint --print-config",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint:ci"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,astro}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
