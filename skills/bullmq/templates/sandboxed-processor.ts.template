// Sandboxed processor — CPU-bound work runs in worker_threads (lighter than child process).
//
// File layout:
//   src/worker-entry.ts        (this file — spawns the BullMQ Worker)
//   src/sandboxed/pdf-render.ts  (the actual job logic — runs in a thread)

// ============================================================
// src/worker-entry.ts
// ============================================================
import { Worker, type ConnectionOptions } from 'bullmq';
import path from 'node:path';
import { pathToFileURL } from 'node:url';

const connection: ConnectionOptions = {
  host: process.env.REDIS_HOST ?? '127.0.0.1',
  port: Number(process.env.REDIS_PORT ?? 6379),
  password: process.env.REDIS_PASSWORD,
  maxRetriesPerRequest: null,
};

// Resolve the processor file's URL (Windows-friendly)
const processorPath = pathToFileURL(
  path.join(import.meta.dirname, 'sandboxed', 'pdf-render.js'),
);

// useWorkerThreads: true — uses Node's worker_threads instead of child processes
// Faster spawn, shared memory address space (per-thread V8 isolates).
const worker = new Worker('pdf-render', processorPath, {
  connection,
  concurrency: 4,                   // 4 threads max
  useWorkerThreads: true,
  lockDuration: 5 * 60_000,         // PDF rendering can be slow
  lockRenewTime: 60_000,
});

worker.on('completed', (job) => console.log(`[pdf] done ${job.id}`));
worker.on('failed',    (job, err) => console.error(`[pdf] failed ${job?.id}`, err));
worker.on('error',     (err) => console.error('[pdf] worker error', err));

async function shutdown() {
  await worker.close();
  process.exit(0);
}
process.once('SIGTERM', shutdown);
process.once('SIGINT',  shutdown);


// ============================================================
// src/sandboxed/pdf-render.ts
// Runs in a worker thread — has its own event loop.
// ============================================================
