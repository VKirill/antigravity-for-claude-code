  // await page.goto(job.data.url);
  // const buffer = await page.pdf({ format: 'A4' });
  // await browser.close();

  // Placeholder:
  await new Promise((r) => setTimeout(r, 1000));
  const buffer = Buffer.alloc(1024 * 1024);   // 1 MB fake PDF

  await job.updateProgress(60);

  // Upload to S3 / R2 / disk (within the thread)
  // await s3.putObject({ Bucket: 'pdfs', Key: job.data.outputKey, Body: buffer });

