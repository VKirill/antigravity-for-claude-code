/* ============================================================
 * Sentry init — Backend (Node) and Frontend (browser) versions.
 * Adjust DSN, release, sample rates per project.
 *
 * Templates below for:
 *   1. Node.js (backend) — instrument.ts loaded FIRST
 *   2. React (frontend) — sentry.ts loaded in entry point
 *   3. FastAPI / Python — sentry_setup.py imported in app entry
 *   4. Build pipeline — uploading source maps + finalising release
 * ============================================================ */

// ============================================================
// 1. Node.js backend — instrument.ts
// ============================================================
// IMPORTANT: this file MUST be imported FIRST in your app entry
// (before express / fastify / database clients / anything).

import * as Sentry from '@sentry/node';
import { nodeProfilingIntegration } from '@sentry/profiling-node';

Sentry.init({
  dsn: process.env.SENTRY_DSN,
  environment: process.env.NODE_ENV ?? 'development',
  release: process.env.SERVICE_VERSION ?? process.env.GIT_SHA,

  // Performance
  tracesSampleRate: process.env.NODE_ENV === 'production' ? 0.1 : 1.0,
  profilesSampleRate: 0.1,

  // PII strictness
  sendDefaultPii: false,
  integrations: [
    nodeProfilingIntegration(),
    // Don't enable HTTP / Express / Fastify integrations that capture headers
    // unless you trust beforeSend to scrub.
  ],

  // Scrub before send
  beforeSend(event, hint) {
    // Strip sensitive headers
    if (event.request?.headers) {
      delete event.request.headers.authorization;
      delete event.request.headers.cookie;
      delete event.request.headers['x-api-key'];
    }
    // Strip sensitive body fields
    if (event.request?.data && typeof event.request.data === 'object') {
      const data = event.request.data as Record<string, unknown>;
      ['password', 'token', 'apiKey', 'secret', 'cvv', 'creditCard'].forEach((k) => {
        if (k in data) data[k] = '[REDACTED]';
      });
    }
    return event;
  },

  // Filter known-noisy errors before they cost a quota slot
  ignoreErrors: [
    'NetworkError',
    'AbortError',  // common when user navigates away mid-request
  ],
});

// Then in your app entry:
//   import './instrument.js';
//   import express from 'express';
