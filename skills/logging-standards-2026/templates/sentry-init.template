// ============================================================
// 2. React frontend — src/sentry.ts
// ============================================================

import * as SentryBrowser from '@sentry/browser';
import { BrowserTracing } from '@sentry/browser';
// import { browserTracingIntegration, replayIntegration } from '@sentry/browser';

SentryBrowser.init({
  dsn: import.meta.env.VITE_SENTRY_DSN,
  environment: import.meta.env.MODE,
  release: import.meta.env.VITE_RELEASE,

  integrations: [
    // browserTracingIntegration(),
    // replayIntegration({ maskAllText: true, blockAllMedia: true }),  // PII-safe
  ],

  tracesSampleRate: 0.1,
  replaysSessionSampleRate: 0,        // off — high cost
  replaysOnErrorSampleRate: 1.0,      // 100% for errors

  sendDefaultPii: false,
  beforeSend(event) {
    // Strip user-controlled URL fragments (might contain tokens)
    if (event.request?.url) {
      event.request.url = event.request.url.replace(/access_token=[^&]+/g, 'access_token=[REDACTED]');
    }
    return event;
  },

  ignoreErrors: [
    'ResizeObserver loop limit exceeded',
    'Non-Error promise rejection captured',
    /^Network request failed$/,
  ],
});

// Identify user — ID only, never email/name unless legally cleared
export function identifyUser(id: string) {
  SentryBrowser.setUser({ id });
}
export function clearUser() {
  SentryBrowser.setUser(null);
}

