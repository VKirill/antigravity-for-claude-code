// ============================================================
// Usage
// ============================================================

/**
 * import { logger } from './logger.js';
 *
 * // In a request handler:
 * logger.info({ msg: 'user.fetched', user_id: id });
 *
 * // Logs include request_id automatically from AsyncLocalStorage.
 *
 * // Child logger with extra scoped context:
 * const log = logger.child({ component: 'auth' });
 * log.info({ msg: 'login.attempted' });
 *
 * // Error:
 * try {
 *   await doThing();
 * } catch (err) {
 *   logger.error({ err, msg: 'thing.failed' });   // serializer extracts stack
 *   throw err;
 * }
 */
