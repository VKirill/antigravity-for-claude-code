// ── Page component ────────────────────────────────────────────────────────────
export default async function {{SEGMENT_NAME}}Page({ params }: Props) {
  const { {{PARAM_NAME}} } = await params   // always await params in Next.js 16
  const item = await {{DATA_FUNCTION}}({{PARAM_NAME}})
  if (!item) notFound()

  return (
    <main>
      <h1>{item.name}</h1>
      {/* Wrap dynamic or heavy sub-sections in Suspense */}
      <Suspense fallback={<{{SEGMENT_NAME}}Skeleton />}>
        <{{SEGMENT_NAME}}Details id={{{PARAM_NAME}}} />
      </Suspense>
    </main>
  )
}

// ── Async sub-component (streams independently) ───────────────────────────────
